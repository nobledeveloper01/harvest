<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen: the app's ground, and the mark centred on it.

  **Android 11 and earlier only.** From Android 12 the system draws its own
  splash — the adaptive icon from `mipmap-anydpi-v26/ic_launcher.xml`, on this
  theme's window background, at a size it chooses — and this layer-list is
  never seen. `launch_mark.png` is generated at 168 dp so that the older path
  is the same size as the newer one, rather than the app appearing to shrink on
  an older phone.

  Generated by `scripts/brandmark.py`; regenerate with `make brandmark`.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
